[Unit]
Description=Logistics Attendance Portal Flask Backend (Gunicorn)
After=network.target mysql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/logistics-attendance/backend
Environment="PATH=/var/www/logistics-attendance/backend/venv/bin"
EnvironmentFile=/var/www/logistics-attendance/backend/.env
ExecStart=/var/www/logistics-attendance/backend/venv/bin/gunicorn -w 4 -b 127.0.0.1:5000 "app:create_app()"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
